; Setup wizard (ADR-0002): Inno Setup 6.5+. scripts/publish.ps1 compiles it when it can find ISCC.exe:
;   ISCC.exe /DAppVersion=1.0.0-beta.N /DSourceDir=<dist\release\win-x64\app> /DOutputDir=<dist\release> installer\SnipToss.iss
; Install, upgrade, downgrade, uninstall and the wizard in every language are tested automatically in Windows Sandbox: tests/sandbox/run.ps1.
; The file is saved as UTF-8 with a BOM: Inno Setup only reliably reads the Chinese and Japanese text in it as UTF-8 when it sees a BOM. The context-menu text matches the message shell.contextMenu
;
; Modeled on VS Code: installs per user by default (no administrator needed) but can install for all users; the "Add to the File Explorer context menu" checkbox is on by default and "Desktop shortcut" is off.
; The app registers the context menu itself (SnipToss.exe --register-context-menu, the same code as Settings → System), and --uninstall-cleanup removes it before uninstalling (app/SetupCommand.cs).
; Uninstalling leaves user data alone: the settings in %APPDATA%\SnipToss, the logs and screenshot archive in %LOCALAPPDATA%\SnipToss, and the .sniptoss folders inside projects.
; "Add to PATH (sniptoss command)" and similar come once the C# command line exists (ADR-0003; the current command line needs Node).

#ifndef AppVersion
  #error Build with /DAppVersion=<version> (scripts/publish.ps1 passes it)
#endif
#ifndef SourceDir
  #define SourceDir "..\dist\release\win-x64\app"
#endif
#ifndef OutputDir
  #define OutputDir "..\dist\release"
#endif
; Install the WebView2 runtime when it is missing: Microsoft's Evergreen bootstrapper (https://go.microsoft.com/fwlink/p/?LinkId=2124703); it is only bundled when placed next to this file
#define WebView2Bootstrapper "MicrosoftEdgeWebview2Setup.exe"

[Setup]
; Never change AppId once set: upgrades and uninstalls identify the app by it
AppId={{4EBB9110-4867-4049-8EFB-B00255A69951}
; The product name in the wizard text follows the wizard language (超级批注 in Chinese; otherwise the title bar would show the Chinese name while the body says SnipToss). Where it installs and which uninstall entry it uses are keyed on AppId and the fixed folder names below, so they do not change with the language
AppName={cm:ProductName}
AppVerName={cm:ProductName} {#AppVersion}
AppVersion={#AppVersion}
AppPublisher=MoyGoldenAge
AppPublisherURL=https://github.com/Moy339339/SnipToss
AppSupportURL=https://github.com/Moy339339/SnipToss/issues
AppUpdatesURL=https://github.com/Moy339339/SnipToss/releases
AppCopyright=Copyright (c) 2026 MoyGoldenAge
VersionInfoVersion=1.0.0
DefaultDirName={autopf}\SnipToss
DefaultGroupName=SnipToss
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Windows 11 only (ADR-0010): on Windows 10 the wizard simply says the system version is too old
MinVersion=10.0.22000
WizardStyle=modern
SetupIconFile=..\app\SnipToss.ico
; The small image at the top right of the wizard and the large image beside the finish page: the product icon (generated by scripts/build-wizard-images.mjs, several DPI variants of each; Inno picks one)
WizardSmallImageFile=images\wizard-small-58.png,images\wizard-small-73.png,images\wizard-small-87.png,images\wizard-small-102.png,images\wizard-small-116.png,images\wizard-small-145.png
WizardImageFile=images\wizard-large-164.png,images\wizard-large-205.png,images\wizard-large-246.png,images\wizard-large-287.png,images\wizard-large-328.png,images\wizard-large-410.png
UninstallDisplayIcon={app}\SnipToss.exe
UninstallDisplayName={cm:ProductName}
OutputDir={#OutputDir}
OutputBaseFilename=SnipToss-{#AppVersion}-win-x64-setup
Compression=lzma2/max
SolidCompression=yes
; If the app is running, ask it to quit first (Restart Manager), and reopen it afterwards if needed
CloseApplications=yes
RestartApplications=no
ShowLanguageDialog=auto
UsePreviousLanguage=no

[Languages]
; The wizard language follows the system, with the same 11 languages as the app. The Simplified and Traditional Chinese language files live in installer/languages (the 6.5.0+ versions from the jrsoftware/issrc repository, which the Inno Setup installer does not always ship); the rest are Inno Setup's own
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "zhCN"; MessagesFile: "languages\ChineseSimplified.isl"
Name: "zhTW"; MessagesFile: "languages\ChineseTraditional.isl"
Name: "ja"; MessagesFile: "compiler:Languages\Japanese.isl"
Name: "ko"; MessagesFile: "compiler:Languages\Korean.isl"
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "de"; MessagesFile: "compiler:Languages\German.isl"
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "it"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "ptBR"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "ru"; MessagesFile: "compiler:Languages\Russian.isl"

[LangOptions]
; Set the Chinese, Japanese and Korean wizard fonts to UI fonts that ship with every Windows 11: the Simplified Chinese and Japanese language files set none, and without one the whole page shows as boxes (the Traditional Chinese file sets Microsoft JhengHei UI itself, which is fine)
zhCN.DialogFontName=Microsoft YaHei UI
zhCN.WelcomeFontName=Microsoft YaHei UI
ja.DialogFontName=Yu Gothic UI
ja.WelcomeFontName=Yu Gothic UI
ko.DialogFontName=Malgun Gothic
ko.WelcomeFontName=Malgun Gothic

[Messages]
; Two small mistakes in Inno's bundled translations: in French "peut-être" (maybe) should be "peut être" (can be); the German title has a stray trailing period
fr.PrivilegesRequiredOverrideText2=%1 peut être installé seulement pour vous, ou pour tous les utilisateurs (nécessite des privilèges administrateur).
de.WizardReady=Bereit zur Installation

[CustomMessages]
; Product name: 超级批注 in Chinese, SnipToss in the other languages (same as the message brand.name)
ProductName=SnipToss
zhCN.ProductName=超级批注
zhTW.ProductName=超級批註
ContextMenu=Add "Open with SnipToss" to the File Explorer context menu
zhCN.ContextMenu=添加到资源管理器右键菜单（「用超级批注打开」）
zhTW.ContextMenu=新增到檔案總管右鍵選單（「以超級批註開啟」）
ja.ContextMenu=エクスプローラーの右クリック メニューに「SnipToss で開く」を追加する
ko.ContextMenu=파일 탐색기 오른쪽 클릭 메뉴에 "SnipToss에서 열기" 추가
fr.ContextMenu=Ajouter « Ouvrir avec SnipToss » au menu contextuel de l’Explorateur de fichiers
de.ContextMenu=„Mit SnipToss öffnen“ zum Kontextmenü des Datei-Explorers hinzufügen
es.ContextMenu=Agregar «Abrir con SnipToss» al menú contextual del Explorador de archivos
it.ContextMenu=Aggiungi «Apri con SnipToss» al menu contestuale di Esplora file
ptBR.ContextMenu=Adicionar "Abrir com o SnipToss" ao menu de contexto do Explorador de Arquivos
ru.ContextMenu=Добавить «Открыть с помощью SnipToss» в контекстное меню проводника
InstallingWebView2=Installing the Microsoft Edge WebView2 Runtime…
zhCN.InstallingWebView2=正在安装 Microsoft Edge WebView2 运行时…
zhTW.InstallingWebView2=正在安裝 Microsoft Edge WebView2 執行階段…
ja.InstallingWebView2=Microsoft Edge WebView2 ランタイムをインストールしています…
ko.InstallingWebView2=Microsoft Edge WebView2 런타임을 설치하는 중…
fr.InstallingWebView2=Installation du runtime Microsoft Edge WebView2…
de.InstallingWebView2=Microsoft Edge WebView2-Runtime wird installiert…
es.InstallingWebView2=Instalando el entorno de ejecución de Microsoft Edge WebView2…
it.InstallingWebView2=Installazione del runtime di Microsoft Edge WebView2…
ptBR.InstallingWebView2=Instalando o runtime do Microsoft Edge WebView2…
ru.InstallingWebView2=Установка среды выполнения Microsoft Edge WebView2…

[Tasks]
Name: "contextmenu"; Description: "{cm:ContextMenu}"
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
#if FileExists(AddBackslash(SourcePath) + WebView2Bootstrapper)
Source: "{#WebView2Bootstrapper}"; Flags: dontcopy
#endif

[InstallDelete]
; On upgrade, clear the old version's UI files (their names contain a hash that differs every version, so they would pile up otherwise)
Type: filesandordirs; Name: "{app}\ui"
; Shortcut names follow the wizard language: when reinstalling in another language, do not leave the previous one alongside (a Chinese install followed by an English reinstall would leave two in the Start menu). Delete every variant of the name; the entries below then recreate it in this run's language
Type: files; Name: "{autoprograms}\SnipToss.lnk"
Type: files; Name: "{autoprograms}\超级批注.lnk"
Type: files; Name: "{autoprograms}\超級批註.lnk"
Type: files; Name: "{autodesktop}\SnipToss.lnk"
Type: files; Name: "{autodesktop}\超级批注.lnk"
Type: files; Name: "{autodesktop}\超級批註.lnk"

[Icons]
Name: "{autoprograms}\{cm:ProductName}"; Filename: "{app}\SnipToss.exe"
Name: "{autodesktop}\{cm:ProductName}"; Filename: "{app}\SnipToss.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\SnipToss.exe"; Parameters: "--register-context-menu"; Flags: runhidden waituntilterminated; Tasks: contextmenu
Filename: "{app}\SnipToss.exe"; Description: "{cm:LaunchProgram,{cm:ProductName}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; Remove the context menu, the start-at-login entry and the long-path directory junctions (delete only the junction itself, so uninstalling never follows it into the user's files)
Filename: "{app}\SnipToss.exe"; Parameters: "--uninstall-cleanup"; Flags: runhidden waituntilterminated; RunOnceId: "SnipTossCleanup"

[Code]
// Is the WebView2 runtime installed? The Evergreen runtime records its version in the registry (per user or per machine; on 64-bit systems under WOW6432Node)
function WebView2Installed(): Boolean;
var
  Version: String;
begin
  Result :=
    (RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) and (Version <> '') and (Version <> '0.0.0.0')) or
    (RegQueryStringValue(HKCU, 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) and (Version <> '') and (Version <> '0.0.0.0'));
end;

#if FileExists(AddBackslash(SourcePath) + WebView2Bootstrapper)
procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
begin
  if (CurStep = ssInstall) and not WebView2Installed() then
  begin
    WizardForm.StatusLabel.Caption := CustomMessage('InstallingWebView2');
    ExtractTemporaryFile('{#WebView2Bootstrapper}');
    // Carry on installing the app even if this fails: when the app cannot start, it shows a download link (the startup-failure page)
    Exec(ExpandConstant('{tmp}\{#WebView2Bootstrapper}'), '/silent /install', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end;
end;
#endif
