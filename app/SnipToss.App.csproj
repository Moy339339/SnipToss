<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop shell: a WPF window + WebView2; the UI itself is in packages/web.
       Targets net10.0-windows (LTS, supported until 2028-11): framework-dependent, so the app itself is only a few MB and needs the .NET 10 desktop runtime.
       Building needs the .NET 10 SDK: use scripts/build-app.ps1 (it finds the SDK through scripts/find-dotnet.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its implicit usings are removed below so Color, Point and similar names do not clash with WPF's -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SnipToss</AssemblyName>
    <RootNamespace>SnipToss.App</RootNamespace>
    <!-- scripts/build-app.ps1 bumps the version each time it builds the installed copy (kept in sync with the root package.json); do not edit by hand.
         During testing it is 1.0.0-beta.N (shown as Beta N in the UI); it becomes a stable version number once the exit criteria are met -->
    <Version>1.0.0</Version>
    <!-- The exe's file properties (Task Manager, Properties → Details) have one language for everyone: the English name.
         The installer, shortcuts and window title follow the UI language (超级批注 in Chinese) -->
    <Product>SnipToss</Product>
    <AssemblyTitle>SnipToss</AssemblyTitle>
    <Description>SnipToss: annotate AI-generated images and videos, and hand the notes back to the agent</Description>
    <!-- Author name: shown as the company and copyright in the exe's properties -->
    <Authors>MoyGoldenAge</Authors>
    <Company>MoyGoldenAge</Company>
    <Copyright>Copyright © 2026 MoyGoldenAge</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon is generated by scripts/build-icon.mjs: 16/20/24/32 are drawn separately on a pixel grid, 40 and up come from the vector master -->
    <ApplicationIcon>SnipToss.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Test entry points for the shell tests (TestHooks.cs): only compiled in when npm run e2e:shell / perf builds into tests/shell/.app (build-app.ps1 -TestHooks);
       the installed copy never includes them (ADR-0004 item 3; build-app.ps1 checks again after building) -->
  <PropertyGroup Condition="'$(SnipTossTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_HOOKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="SnipToss.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The test project (tests/AppTests) tests internal classes: settings read/write, atomic writes, single-instance messages, etc. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AppTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- ICU MessageFormat for the messages (plurals by CLDR rules, select); reads the same messages as the UI's intl-messageformat (docs/adr/0001-i18n.md item 3) -->
    <PackageReference Include="MessageFormat" Version="8.0.0" />
  </ItemGroup>

  <!-- Messages (the same files as the UI) are embedded in the app: Locale.cs reads locales.<language>.json -->
  <ItemGroup>
    <EmbeddedResource Include="..\i18n\locales\*.json" LogicalName="locales.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The license and third-party notices sit next to the app (visible in the published zip and in the install folder; the notices are generated by scripts/build-notices.mjs) -->
  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The UI build output (npm run build) is copied to ui/ in the output folder -->
  <ItemGroup>
    <Content Include="..\packages\web\dist\**\*" LinkBase="ui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
